
{% set tiistai = '
  session Tiistai
    ex "Ranskalainen punnerrus"
    ex Hauiskääntö
    ex Lantionnostot
    ex "Askelkyykky ATG"
    ex "Etukyykky kahvakuula sivulla"
    ex Hypyt'
%}

{% set torstai = '
  session Torstai
    ex Penkki
    ex Hyljesoutu
    ex Askelkyykky
    ex "Yhden jalan RDL"
    ex Voimarulla'
%}

program "2026-09"

  cycle "Viikko 1"
    session Maanantai
      ex Vapu 3x75% 3x80% 2x3x83% 2x3x85%
      ex Te-veto 4x60% 2x4x65% 2x3x68%
      ex Kyykky 1x70% 1x80% 1x90% 2x3x80% 3x9x70%
      ex Lantionnostot 3x10

    session Tiistai

    session Keskiviikko
      ex "Te-allemeno nivusilta + vala + allepudotus niskalta" 5x3+3+3x40%
      ex "Te-veto + tempaus riipusta AP" 2+2x65% 2+2x70% 2+2x73% 2x2+2x75%
      ex Tempokyykky 2x3x80%
      ex "Bulgarialainen kyykky" 6x5x40

    session Torstai

    session Perjantai
      ex "Raakatyöntö" 3x65% 2x3x70% 2x3x73%
      ex Ty-veto 5x65% 5x75% 5x85%
      ex Etukyykky 1x70% 1x80% 1x90% 2x3x80% 3x5x75%
      ex Pekkakyykky 2x4x65%

    session Lauantai
      ex "Te-allemeno nivusilta + vala + allepudotus niskalta" 5x3+3+3x40%
      ex "Tempaus EMOM" 20x1x70%
      ex Te-veto 5x70% 5x74% 2x4x77%
      ex "YT pukeilta" 2x80% 2x2x85% 2x90% 1x95%

    session Sunnuntai

  cycle "Viikko 2"
    session Maanantai
      ex Vapu 3x80% 3x85% 3x90% 2x3x93%
      ex Ty-veto 5x70% 5x75% 5x78% 5x80% 5x83%
      ex Etukyykky 1x70% 1x80% 1x90% 2x3x80% 3x5x75%
      ex Pekkakyykky 2x4x65%
      ex Lantionnostot 3x10

    session Tiistai

    session Keskiviikko
      ex "Te-allemeno nivusilta + vala + allepudotus niskalta" 5x3+3+3x40%
      ex "Te pukeilta AP" 3x75% 3x80% 3x83% 2x3x85%
      ex Te-veto 5x70% 5x72% 2x5x76% 2x3x81%
      ex Kyykky 1x70% 1x80% 1x90% 2x3x80% 4x9x70%

    session Torstai

    session Perjantai
      ex Raakatyöntö 3x65% 2x3x70% 2x3x73%
      ex Stoppikyykky 2x3x80%
      ex "Bulgarialainen kyykky" 6x5x60
      ex Te-veto 2x5x73% 2x5x77% 2x5x82% 2x5x86%

    session Lauantai
      ex "Tempaus EMOM" 20x1x75%
      ex "Rive pukeilta AP + etukyykky + YT" 2+2+2x70% 2x2+2+2x76% 2x2+2+1x80%
      ex Ty-veto 5x73% 5x80% 5x87% 5x91%
      ex "YT pukeilta" 2x80% 2x2x85% 2x90% 1x95%

    session Sunnuntai

  cycle "Viikko 3"
    session Maanantai
      ex Vapu 3x80% 3x85% 3x90% 3x93% 2x2x95%
      ex Ty-veto 5x75% 5x80% 5x85% 5x90% 2x3x95%
      ex Etukyykky 1x70% 1x80% 1x90% 4x2x85%
      ex Pekkakyykky 2x5x65%
      ex Lantionnostot 3x10

    session Tiistai

    session Keskiviikko
      ex "Te-allemeno nivusilta + vala + allepudotus niskalta" 5x3+3+3x40%
      ex "Te riipusta AP" 3x75% 3x80% 3x83% 2x3x85%
      ex Te-veto 5x86% 5x90% 4x95% 2x3x99%
      ex Kyykky 1x70% 1x80% 1x90% 3x3x85%
      ex "Kyykky AMRAP 80%"

    session Torstai

    session Perjantai
      ex Raakatyöntö 3x65% 2x3x70% 2x3x73%
      ex "YT EMOM" 20x1x70%
      ex Te-veto 5x85% 5x90% 2x3x95% 2x99%
      ex "Bulgarialainen kyykky" 6x5x60

    session Lauantai
      ex "Tempaus E1M5OM" 1x80% 1x84% 1x87% 1x90% 1x93% 1x95% 1x97% 1x93% 2x1x90% 2x1x87%
      ex Työntö 1x80% 1x85% 1x90% 1x93% 1x95%
      ex Ty-veto 5x73% 5x80% 5x87% 5x91%
      ex Tempokyykky 3x3x70%

    session Sunnuntai

  cycle "Viikko 4"
    session Maanantai

    session Tiistai

    session Keskiviikko
      ex "Te-allemeno nivusilta + vala + allepudotus niskalta" 5x3+3+3x40%
      ex "Te-veto + te riipusta"
      ex Kyykky

    session Torstai

    session Perjantai
      ex Raakatyöntö

    session Lauantai
      ex "Tempaus E1M5OM" 1x80% 1x84% 1x87% 1x90% 1x93% 1x95% 1x97% 2x1x94% 3x1x90% 3x1x85%
      ex Työntö
      ex Tempokyykky
      ex "Bulgarialainen kyykky"

    session Sunnuntai

  cycle "Viikko 5"
    session Maanantai

    session Tiistai

    session Keskiviikko

    session Torstai

    session Perjantai

    session Lauantai
      ex Tempaus 2x85% 1x88% 1x92% 1x96% 1x99%
      ex Työntö

    session Sunnuntai

  cycle "Viikko 6 (kevyt)"
    session Maanantai

    session Tiistai

    session Keskiviikko

    session Torstai

    session Perjantai

    session Lauantai
      ex Tempaus 2x85% 1x90% 1x94% 1x98% 1x101%

    session Sunnuntai

  cycle "Viikko 7"
    session Maanantai

    session Tiistai

    session Keskiviikko
      ex Työntö 1x70% 1x77% 1x85% 1x92% 1x97% 1x100%

    session Torstai

    session Perjantai

    session Lauantai
      ex Tempaus 2x85% 1x90% 1x94% 1x98% 1x101% 1x103%

    session Sunnuntai

  cycle "Viikko 8"
    session Maanantai

    session Tiistai

    session Keskiviikko

    session Torstai

    session Perjantai

    session Lauantai
      ex Kisa

    session Sunnuntai

