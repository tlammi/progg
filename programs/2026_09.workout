
{% set tiistai = '
  session Tiistai
    ex "Ranskalainen punnerrus"
    ex Hauiskääntö
    ex Lantionnostot
    ex "Askelkyykky ATG"
    ex "Etukyykky kahvakuula sivulla"
    ex Hypyt'
%}

{% set torstai = '
  session Torstai
    ex Penkki
    ex Hyljesoutu
    ex Askelkyykky
    ex "Yhden jalan RDL"
    ex Voimarulla'
%}

program "2026-09"

  cycle "Viikko 1"
    session Maanantai
      ex Te-veto 2x4x60% 2x4x65% 2x3x68%
      ex Tempokyykky 3x3x85%
      ex "Bulgarialainen kyykky" 6x5x40
      ex Lantionnostot 3x10
      ex Vapu 3x75% 3x80% 2x3x83% 2x3x85%

    session Tiistai

    session Keskiviikko
      ex "Te-allemeno nivusilta AP + vala + allepudotus niskalta" 5x3+3+3x40%
      ex "Te-veto + tempaus riipusta AP" 2+2x65% 2+2x70% 2+2x73% 2x2+2x75%
      ex Kyykky 1x70% 1x80% 1x90% 2x3x80% 3x9x70%

    session Torstai

    session Perjantai
      ex "Raaka-työntö" 3x65% 2x3x70% 2x3x73%
      ex Ty-veto 2x5x65% 2x5x75% 1x5x85%
      ex Etukyykky 1x70% 1x80% 1x90% 2x3x80% 3x5x75%
      ex Pekkakyykky 2x6x65%

    session Lauantai
      ex "Tempaus EMOM" 15x1x70%
      ex Te-veto 5x70% 5x74% 4x4x77%

    session Sunnuntai

  cycle "Viikko 2"
    session Maanantai
      ex Raaka-työntö 3x68% 3x73% 2x2x78%
      ex Ty-veto 5x70% 5x75% 5x78% 5x80% 5x83%
      ex Etukyykky 1x70% 1x80% 1x90% 2x3x80% 3x5x75%
      ex Pekkakyykky 2x5x65%
      ex Lantionnostot 3x10
      ex Vapu 3x80% 3x85% 3x90% 2x3x93%

    session Tiistai

    session Keskiviikko
      ex "Te-allemeno nivusilta AP + vala + allepudotus niskalta" 5x3+3+3x40%
      ex "Te pukeilta AP" 3x75% 3x80% 3x83% 2x3x85%
      ex Te-veto 2x5x70% 2x5x72% 3x5x76% 2x3x81%
      ex Kyykky 1x70% 1x80% 1x90% 2x3x80% 4x9x70%

    session Torstai

    session Perjantai
      ex Te-veto 2x5x73% 2x5x77% 2x5x82% 2x5x86%
      ex Stoppikyykky 3x3x85%
      ex "Bulgarialainen kyykky" 6x5x60

    session Lauantai
      ex "Tempaus EMOM" 20x1x75%
      ex "Rive pukeilta AP + etukyykky + YT" 2+2+2x70% 2x2+2+2x76% 2x2+2+1x80%
      ex Ty-veto 5x73% 5x80% 5x87% 5x91%
      ex Kyykky 1x70% 1x80% 1x90% 3x80% 2x9x70%

    session Sunnuntai

  cycle "Viikko 3"
    session Maanantai
      ex Raaka-työntö 3x68% 3x73% 2x2x78%
      ex Ty-veto 2x5x70% 2x5x75% 2x5x78% 5x80% 5x83%
      ex Etukyykky 1x70% 1x80% 1x90% 2x3x80% 3x5x75%
      ex Pekkakyykky 2x5x65%
      ex Lantionnostot 3x10
      ex Vapu 3x80% 3x85% 3x90% 2x3x93%

    session Tiistai

    session Keskiviikko
      ex "Te-allemeno nivusilta AP + vala + allepudotus niskalta" 5x3+3+3x40%
      ex "Te pukeilta AP" 3x75% 3x80% 3x83% 2x3x85%
      ex Te-veto 2x5x70% 2x5x72% 3x5x76% 2x3x81%
      ex Kyykky 1x70% 1x80% 1x90% 2x3x80% 4x9x70%

    session Torstai

    session Perjantai
      ex Te-veto 2x5x73% 2x5x77% 2x5x82% 2x5x86%
      ex Stoppikyykky 3x3x85%
      ex "Bulgarialainen kyykky" 6x5x60

    session Lauantai
      ex "Tempaus EMOM" 20x1x80%
      ex "Rive pukeilta AP + etukyykky + YT" 2+2+2x70% 2x2+2+2x76% 2x2+2+1x80%
      ex Ty-veto 5x73% 5x80% 5x87% 5x91%
      ex Kyykky 1x70% 1x80% 1x90% 3x80% 2x9x70%

    session Sunnuntai

  cycle "Viikko 4"
    # Kevyt
    session Maanantai

    session Tiistai

    session Keskiviikko

    session Torstai

    session Perjantai

    session Lauantai
      ex "Tempaus E1,5MOM" 20x85%

    session Sunnuntai

  cycle "Viikko 5"
    session Maanantai

    session Tiistai

    session Keskiviikko

    session Torstai

    session Perjantai

    session Lauantai

    session Sunnuntai

  cycle "Viikko 6"
    # Kevyt
    session Maanantai

    session Tiistai

    session Keskiviikko

    session Torstai

    session Perjantai

    session Lauantai

    session Sunnuntai

  cycle "Viikko 7"
    session Maanantai

    session Tiistai

    session Keskiviikko
      ex Työntö 1x70% 1x77% 1x85% 1x92% 1x97% 1x100%

    session Torstai

    session Perjantai

    session Lauantai
      ex Tempaus 2x85% 1x90% 1x94% 1x98% 1x101% 1x103%

    session Sunnuntai

  cycle "Viikko 8"
    session Maanantai

    session Tiistai

    session Keskiviikko

    session Torstai

    session Perjantai

    session Lauantai
      ex Kisa

    session Sunnuntai

